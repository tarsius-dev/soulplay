# SeoulPlay Environment Configuration (Example)
# NOTE: Never commit real credentials or .env.local to version control.

# Site URL
VITE_SITE_URL="https://seoulplay.example.com"
NEXT_PUBLIC_SITE_URL="https://seoulplay.example.com"

# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side Supabase Service Role Key (Used strictly for server-side admin provisioning or verification tasks; never expose to client!)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Authorized Video Embedding Configuration
# Comma-separated list of approved hostname patterns (HTTPS only)
VITE_APPROVED_VIDEO_HOSTS="youtube.com,www.youtube.com,youtu.be,player.vimeo.com,vimeo.com,www.dailymotion.com,archive.org"

# Advertising Architecture (Disabled by default)
VITE_ADS_ENABLED="false"
VITE_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADS_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT=""

# Initial Admin Configuration for Setup Documentation
ADMIN_EMAIL="admin@seoulplay.example.com"
